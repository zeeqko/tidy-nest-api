# Copy to .env (gitignored) and fill in. The backend reads these from the
# process environment — e.g. `set -a; source .env; set +a; go run ./cmd/server`.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/organizing_app?sslmode=disable

# Item photo storage (Cloudflare R2). Set all four to use the bucket that
# infra/ provisions; leave all four empty to store photos on local disk.
# Account ID: dash.cloudflare.com -> right sidebar of the account home.
# Bucket:     `terraform -chdir=infra output item_images_bucket_name`
# Key pair:   R2 -> Manage API Tokens -> Create API token (Object Read & Write).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local-disk fallback directory, used only when the R2 vars are unset.
UPLOAD_DIR=uploads

# Gemini API key for the "AI Recognition" Add Item upload mode (photo ->
# suggested category + item name). Get one at https://aistudio.google.com/apikey.
# Leave empty to disable — the endpoint responds 503 and the client falls
# back to manual entry.
GEMINI_API_KEY=

